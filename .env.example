# Supabase Postgres. Use the "Transaction pooler" connection string from
# Project Settings > Database (port 6543); serverless functions need the
# pooler, not the direct connection. Append ?sslmode=no-verify because the
# pooler certificate is not in the default trust store.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
# Leave unset to run read-only from the static files in data/.
DATABASE_URL=

# Admin portal login. Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Discord invite shown at the end of the manifesto.
NEXT_PUBLIC_DISCORD_URL=

# WhatsApp group invite shown at the end of the manifesto.
NEXT_PUBLIC_WHATSAPP_URL=

# Supabase Storage for uploaded images (events, communities, ...). Server only:
# never prefix these with NEXT_PUBLIC_. See docs/SUPABASE.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images
